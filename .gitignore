# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# netlify
.netlify/

# model ölçümü — girdi/çıktı görselleri ağır; kayıtlar (jsonl/json) izlenir
/scripts/olcum/girdi/
/scripts/olcum/cikti/*
!/scripts/olcum/cikti/sonuclar.jsonl
!/scripts/olcum/cikti/rapor.json
# Kabul kapısının eşiği (ürün>=4, anatomi>=3) bu dosyadaki 30 etiketli
# kareye dayanıyor. İzlenmezse eşik kararının tek kanıtı ve tek gerileme
# testinin girdisi bu makineyle birlikte kaybolur.
!/scripts/olcum/cikti/hakem.json
