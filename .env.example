# Google AI Studio anahtarı — https://aistudio.google.com/apikey
# Görsel modellerinde ücretsiz katman yoktur; anahtarı faturalandırma açık
# bir projede oluşturun.
GEMINI_API_KEY=

# Kullanılacak model. Aşağıdaki sayılar ölçülmüştür, tahmin değil —
# 8 vakalık altın set, 2026-08-28 (bkz. scripts/olcum/README.md).
#
#   model                          kabul   p50      kabul başına
#   gemini-3.1-flash-image         %88     11,6 sn  0,068 $   ← birincil
#   gemini-3.1-flash-lite-image    %88      4,6 sn  0,040 $   ← hızlı önizleme
#   gemini-3-pro-image             %100    17,5 sn  0,142 $   ← yeniden deneme / zor vaka
#   gemini-2.5-flash-image         %50     13,7 sn  0,068 $   ← kullanmayın
COMPOSE_MODEL=gemini-3.1-flash-image

# Üretim çözünürlüğü: 1K | 2K | 4K
COMPOSE_IMAGE_SIZE=1K

# --- Kabul kapısı ve kademeli yeniden deneme (Faz 3) ---
# Üretilen kare, kullanıcıya gösterilmeden önce ucuz bir görsel modeliyle
# puanlanır. Eşiği geçemezse daha güçlü modelle bir kez daha denenir; o da
# geçemezse iki karenin iyisi gösterilir (üretim başarısız sayılmaz).
#
# Beklenen etki: istek başına maliyet ~0,068 $ yerine ~0,13 $, gecikme
# 12 sn yerine kötü durumda ~40 sn. Karşılığında bozuk el/parmak ve ürün
# bozulması olan kareler kullanıcıya ulaşmıyor.
COMPOSE_QUALITY_GATE=1
COMPOSE_JUDGE_MODEL=gemini-3.1-flash-lite
COMPOSE_ESCALATE_MODEL=gemini-3-pro-image
COMPOSE_MAX_ATTEMPTS=2

# Kapının eşikleri (0-5). 30 etiketli kare üzerinde seçildi; bkz.
# scripts/olcum/hakem.mjs. Yükseltmek daha çok yeniden deneme demek.
COMPOSE_ESIK_URUN=4
COMPOSE_ESIK_ANATOMI=3

# Yayındaki adres. Mutlak URL üreten her yer (OG etiketleri, sitemap,
# robots) bunu kullanır. Yerelde boş bırakılabilir.
NEXT_PUBLIC_SITE_URL=https://selviai.com
