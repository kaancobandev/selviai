# Google AI Studio anahtarı — https://aistudio.google.com/apikey
# Görsel modellerinde ücretsiz katman yoktur; anahtarı faturalandırma açık
# bir projede oluşturun.
GEMINI_API_KEY=

# Kullanılacak model. Alternatifler:
#   gemini-3.1-flash-image        birincil, 1K ~0,067 $
#   gemini-3.1-flash-lite-image   ucuz taslak, yalnız 1K
#   gemini-3-pro-image            zor sahne / 4K
COMPOSE_MODEL=gemini-3.1-flash-image

# Üretim çözünürlüğü: 1K | 2K | 4K
COMPOSE_IMAGE_SIZE=1K

# Yayındaki adres. Mutlak URL üreten her yer (OG etiketleri, sitemap,
# robots) bunu kullanır. Yerelde boş bırakılabilir.
NEXT_PUBLIC_SITE_URL=https://selviai.com
